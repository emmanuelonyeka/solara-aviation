# Copy this file to .env. Demo mode is the safe default: every form remains
# fully interactive, but no email is sent.

VITE_FORM_MODE=demo

# EmailJS browser credentials. These values are intentionally public-facing
# identifiers, so restrict the EmailJS key and templates to your approved domain.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_STAFF_TEMPLATE=
VITE_EMAILJS_CLIENT_TEMPLATE=

# Optional. Leave blank to use the hero still image instead of loading video.
# After adding the file to public/media, use: /media/hero-clouds.mp4
VITE_HERO_VIDEO_URL=/media/hero-clouds.mp4
